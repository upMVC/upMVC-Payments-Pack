{
    "name": "bitshost/upmvc-payments-pack",
    "description": "Installable payments pack for upMVC SaaS: gateway contracts, tenant-scoped payment records, thin APIs. Pair with bitshost/upmvc-saas-pack for multi-tenant products.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "bitshost/upmvc": "^2.4",
        "bitshost/upmvc-saas-pack": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "stripe/stripe-php": "Required only when PAYMENTS_DRIVER=stripe (StripeGateway).",
        "paypal/paypal-server-sdk": "Required only when PAYMENTS_DRIVER=paypal (PayPalGateway — Order/Capture wiring in progress)."
    },
    "authors": [
        {
            "name": "Adrian D",
            "email": "contact@delvirai.net",
            "homepage": "https://upmvc.com",
            "role": "Developer"
        }
    ],
    "license": ["MIT"],
    "autoload": {
        "psr-4": {
            "App\\Modules\\": "src/Modules/",
            "BitsHost\\UpmvcPayments\\": "src/Payments/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BitsHost\\UpmvcPayments\\Tests\\": "tests/"
        }
    },
    "keywords": [
        "upmvc",
        "saas",
        "payments",
        "billing",
        "module-pack",
        "stripe",
        "multi-tenant"
    ],
    "homepage": "https://upmvc.com"
}
